          {
            "name": "_faultNote",
            "value": "AS RECEIVED (FAULTY): dates parsed as MM/DD/YYYY although the client system sends ISO YYYY-MM-DD, so every date is invalid; amount rule inverted (< instead of >=). Runs green, silently drops every valid record."
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {}
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{1.orders}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {}
      }
    },
    {
      "id": 4,
      "module": "tools:SetVariable",
      "version": 1,
      "parameters": {},
      "mapper": {
        "name": "parsedDate",
        "value": "{{parseDate(3.value.orderDate; \"MM/DD/YYYY\")}}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {}
      },
      "filter": {
        "name": "Keep rule",
        "conditions": [
          [
            {
              "a": "{{4.parsedDate}}",
              "b": "",
