        },
        "restore": {}
      }
    },
    {
      "id": 6,
      "module": "tools:SetVariable",
      "version": 1,
      "parameters": {},
      "mapper": {
        "name": "keptIds",
        "value": "{{map(5.array; \"orderId\")}}"
      },
      "metadata": {
